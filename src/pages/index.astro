    <script is:inline>
      const root = document.documentElement;
      const toggle = document.querySelector('.toggle');
      const ambientMark = document.querySelector('.ambient-mark');
      const siteBrand = document.querySelector('.site-brand');
      const heroLockup = document.querySelector('.lockup');
      const contentSections = [...document.querySelectorAll('.content-section')];
      const viewIds = ['home', 'download', 'security', 'support'];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let activeTransition = null;

      const viewFromHash = () => {
        const hashView = window.location.hash.slice(1);
        if (hashView === 'top' || !viewIds.includes(hashView)) return 'home';
        return hashView;
      };

      const syncViewAccessibility = (view) => {
        contentSections.forEach((section) => {
          const active = section.id === view;
          section.inert = !active;
          section.setAttribute('aria-hidden', String(!active));
        });

        const homeActive = view === 'home';
        heroLockup.inert = !homeActive;
        heroLockup.setAttribute('aria-hidden', String(!homeActive));
        siteBrand.inert = homeActive;
        siteBrand.setAttribute('aria-hidden', String(homeActive));

        document.querySelectorAll('.site-nav a').forEach((link) => {
          const active = link.getAttribute('href') === `#${view}`;
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      };

      const focusViewHeading = (view) => {
        const headingId = view === 'home' ? 'hero-title' : `${view}-title`;
        const heading = document.getElementById(headingId);
        if (!heading) return;
        heading.setAttribute('tabindex', '-1');
        heading.focus({ preventScroll: true });
      };

      const commitView = (view) => {
        root.dataset.view = view;
        syncViewAccessibility(view);
      };

      const navigateTo = (view, options = {}) => {
        const { pushHistory = true, moveFocus = true } = options;
        if (!viewIds.includes(view)) view = 'home';

        if (root.dataset.view === view) {
          syncViewAccessibility(view);
          if (moveFocus) focusViewHeading(view);
          return;
        }

        if (pushHistory) {
          const nextHash = view === 'home' ? '#top' : `#${view}`;
          try {
            window.history.pushState({ view }, '', nextHash);
          } catch {
            window.location.hash = nextHash;
          }
        }

        root.classList.add('intro-complete');
        const applyView = () => commitView(view);
        const canTransition = document.startViewTransition && !reduceMotion.matches;

        if (canTransition) {
          activeTransition?.skipTransition();
          const transition = document.startViewTransition(applyView);
          activeTransition = transition;
          transition.finished
            .then(() => {
              if (moveFocus && root.dataset.view === view) focusViewHeading(view);
            })
            .finally(() => {
              if (activeTransition === transition) activeTransition = null;
            });
        } else {
          applyView();
          if (moveFocus)
            window.setTimeout(() => focusViewHeading(view), reduceMotion.matches ? 0 : 440);
        }
      };

      const updateToggleLabel = () => {
        const nextTheme = root.dataset.theme === 'dark' ? '浅色' : '深色';
        const label = `切换到${nextTheme}背景`;
        toggle.setAttribute('aria-label', label);
        toggle.setAttribute('title', label);
      };

      toggle.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        updateToggleLabel();
      });

      document.addEventListener('click', (event) => {
        const link = event.target.closest('a[href^="#"]');
        if (!link) return;
        const hashTarget = link.getAttribute('href').slice(1);
        const view = hashTarget === 'top' ? 'home' : hashTarget;
        if (!viewIds.includes(view)) return;
        event.preventDefault();
        navigateTo(view);
      });

      let historySyncQueued = false;
      const syncViewFromLocation = () => {
        if (historySyncQueued) return;
        historySyncQueued = true;
        window.queueMicrotask(() => {
          historySyncQueued = false;
          navigateTo(viewFromHash(), { pushHistory: false, moveFocus: true });
        });
      };
      window.addEventListener('popstate', syncViewFromLocation);
      window.addEventListener('hashchange', syncViewFromLocation);
      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && root.dataset.view !== 'home') {
          navigateTo('home');
        }
      });

      ambientMark.addEventListener(
        'animationend',
        () => {
          root.classList.add('intro-complete');
        },
        { once: true },
      );

      const currentView = root.dataset.view || viewFromHash();
      commitView(currentView);
      if (currentView !== 'home') root.classList.add('intro-complete');
      updateToggleLabel();
    </script>
  </body>
</html>
