      @media (max-height: 520px) {
        .lockup {
          gap: 12px;
          transform: translateY(2vh);
        }
        .hero-mark {
          width: 150px;
        }
        .wordmark {
          font-size: 56px;
        }
        .hero-download {
          height: 42px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .ambient-mark,
        .hero-mark circle,
        .wordmark,
        .hero-download {
          animation: none;
        }
      }
    </style>
  </head>
