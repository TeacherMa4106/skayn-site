<!doctype html>
<html lang="zh-CN" data-theme="dark" data-view="home">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Skayn — 官方网站</title>
    <meta name="description" content="Skayn 官方网站：查看发布状态、安全与隐私原则和支持渠道。" />
  <link rel="icon" type="image/svg+xml" href="./skayn-logo.svg" />
    <link rel="canonical" href="https://skayn.net/" />
    <meta property="og:title" content="Skayn — 官方网站" />
    <meta property="og:description" content="查看 Skayn 发布状态、安全与隐私原则和支持渠道。" />
    <meta property="og:url" content="https://skayn.net/" />
    <meta property="og:type" content="website" />
  <script is:inline>
      document.documentElement.classList.add('js');
      if (document.startViewTransition) {
        document.documentElement.classList.add('has-view-transitions');
      }
    const navigationEntry = performance.getEntriesByType('navigation')[0];
    const isReload = navigationEntry?.type === 'reload';
      const requestedView = window.location.hash.slice(1);
      if (isReload) {
        document.documentElement.dataset.view = 'home';
        try {
          window.history.replaceState({ view: 'home' }, '', '#top');
        } catch {
          window.location.hash = 'top';
        }
      } else if (['download', 'security', 'support'].includes(requestedView)) {
        document.documentElement.dataset.view = requestedView;
      }
    </script>
    <style>
      :root {
        --purple: #7c5cfc;
        --raspberry: #e30b5c;
        --lime: #c6ff00;
        --ink: #090a0c;
        --paper: #f5f6f3;
        --footer-height: 48px;
        font-family: Inter, 'Segoe UI', 'PingFang SC', system-ui, sans-serif;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html[data-theme='dark'] {
        --bg: var(--ink);
        --wordmark: #f7f7f5;
        --control: #f7f7f5;
        --ambient-opacity: 0.24;
        --surface: #111216;
        --muted: #a9abb3;
        --line: rgba(255, 255, 255, 0.12);
        --ambient-detail-opacity: 0.09;
      }
      html[data-theme='light'] {
        --bg: var(--paper);
        --wordmark: var(--ink);
        --control: var(--ink);
        --ambient-opacity: 0.16;
        --surface: #e9ebe7;
        --muted: #5d6068;
        --line: rgba(9, 10, 12, 0.14);
        --ambient-detail-opacity: 0.07;
      }

      html {
        scroll-behavior: smooth;
        background: var(--bg);
      }

      body {
        min-height: 100vh;
        overflow-x: hidden;
        background: var(--bg);
        color: var(--wordmark);
        transition: background-color 260ms ease;
      }

      html.js {
        height: 100%;
        overflow: hidden;
      }
      html.js body {
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
        display: grid;
        grid-template-rows: minmax(0, 1fr) var(--footer-height);
      }
      html.js main {
        position: relative;
        min-height: 0;
        overflow: visible;
      }

      .toggle {
        position: relative;
        flex: 0 0 auto;
        width: 40px;
        height: 40px;
        border: 1px solid currentColor;
        border-radius: 50%;
        background: transparent;
        color: var(--control);
        cursor: pointer;
        display: grid;
        place-items: center;
        opacity: 0.72;
        transition:
          color 260ms ease,
          opacity 180ms ease,
          transform 180ms ease;
      }
      .toggle:hover {
        opacity: 1;
        transform: rotate(18deg);
      }
      .toggle:focus-visible {
        outline: 2px solid var(--purple);
        outline-offset: 4px;
      }

      .theme-icon {
        position: relative;
        width: 16px;
        height: 16px;
        border: 1.5px solid currentColor;
        border-radius: 50%;
        overflow: hidden;
      }
      .theme-icon::after {
        content: '';
        position: absolute;
        inset: 0 0 0 50%;
        background: currentColor;
      }

      .site-header {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 10;
        width: 100%;
        height: 76px;
        padding: 0 28px;
        border-bottom: 1px solid transparent;
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition:
          background-color 260ms ease,
          border-color 260ms ease;
      }
      html:not([data-view='home']) .site-header {
        border-bottom-color: var(--line);
        background: var(--bg);
      }
      .site-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--wordmark);
        font-size: clamp(13px, 0.75vw, 15px);
        font-weight: 750;
        letter-spacing: 0;
        text-decoration: none;
      }
      .site-brand img {
        width: 28px;
        height: 28px;
      }
      .back-arrow {
        width: 20px;
        color: var(--muted);
        font-size: 21px;
        font-weight: 500;
        line-height: 1;
        transition:
          color 180ms ease,
          transform 180ms ease;
      }
      .site-brand:hover .back-arrow {
        color: var(--wordmark);
        transform: translateX(-3px);
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: clamp(14px, 1.3vw, 26px);
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: clamp(16px, 1.4vw, 28px);
      }
      .site-nav a {
        position: relative;
        color: var(--muted);
        font-size: clamp(12px, 0.7vw, 14px);
        font-weight: 600;
        text-decoration: none;
        transition: color 180ms ease;
      }
      .site-nav a:hover {
        color: var(--wordmark);
      }
      .site-nav .nav-download {
        color: var(--wordmark);
      }
      .site-nav a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -8px;
        height: 2px;
        background: var(--nav-accent, transparent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 220ms ease;
      }
      html[data-view='download'] .site-nav a[href='#download'] {
        --nav-accent: var(--lime);
        color: var(--wordmark);
      }
      html[data-view='security'] .site-nav a[href='#security'] {
        --nav-accent: var(--purple);
        color: var(--wordmark);
      }
      html[data-view='support'] .site-nav a[href='#support'] {
        --nav-accent: var(--raspberry);
        color: var(--wordmark);
      }
      html:not([data-view='home']) .site-nav a[aria-current='page']::after {
        transform: scaleX(1);
      }

      html.js .site-brand {
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition:
          opacity 220ms ease,
          transform 360ms cubic-bezier(0.2, 0.7, 0.2, 1),
          visibility 0s linear 360ms;
      }
      html.js:not([data-view='home']) .site-brand {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        transition-delay: 180ms, 180ms, 0s;
      }
      html.js[data-view='home'] .hero-mark {
        view-transition-name: brand-mark;
      }
      html.js[data-view='home'] .wordmark {
        view-transition-name: brand-word;
      }
      html.js:not([data-view='home']) .site-brand img {
        view-transition-name: brand-mark;
      }
      html.js:not([data-view='home']) .site-brand-name {
        view-transition-name: brand-word;
      }

      .stage {
        position: relative;
        height: 88vh;
        height: 88dvh;
        max-height: 920px;
        width: 100vw;
        overflow: hidden;
        display: grid;
        place-items: center;
      }
      html.js .stage {
        position: absolute;
        inset: 0;
        height: 100%;
        max-height: none;
        overflow: visible;
      }

      .ambient-mark {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 0;
        width: min(max(100vw, 120vh), 1680px);
        width: min(max(100vw, 120dvh), 1680px);
        max-width: none;
        opacity: var(--ambient-opacity);
        transform: translate(-50%, -50%) rotate(-8deg);
        transition:
          opacity 520ms ease,
          transform 620ms cubic-bezier(0.2, 0.7, 0.2, 1);
        animation: ambient-in 1000ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
        view-transition-name: ambient-mark;
      }
      html.js.intro-complete .ambient-mark,
      html.js:not([data-view='home']) .ambient-mark {
        animation: none;
      }
      html.js[data-view='download'] .ambient-mark {
        opacity: var(--ambient-detail-opacity);
        transform: translate(-50%, -50%) rotate(6deg) scale(0.94);
      }
      html.js[data-view='security'] .ambient-mark {
        opacity: var(--ambient-detail-opacity);
        transform: translate(-50%, -50%) rotate(-22deg) scale(0.98);
      }
      html.js[data-view='support'] .ambient-mark {
        opacity: var(--ambient-detail-opacity);
        transform: translate(-50%, -50%) rotate(18deg) scale(1.04);
      }

      .lockup {
        position: relative;
        z-index: 2;
        display: grid;
        justify-items: center;
        gap: 28px;
        transform: translateY(-2vh);
        pointer-events: none;
        opacity: 1;
        visibility: visible;
        transition:
          opacity 200ms ease,
          transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1),
          visibility 0s;
      }
      html.js:not([data-view='home']) .lockup {
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8vh) scale(0.84);
        transition-delay: 0s, 0s, 240ms;
      }

      .hero-mark {
        width: clamp(220px, 32vmin, 360px);
        aspect-ratio: 1;
      }
      .tone-purple {
        stroke: var(--purple);
      }
      .tone-raspberry {
        stroke: var(--raspberry);
      }
      .tone-lime {
        stroke: var(--lime);
      }

      .hero-mark .tone-purple {
        --tone-delay: 140ms;
      }
      .hero-mark .tone-raspberry {
        --tone-delay: 260ms;
      }
      .hero-mark .tone-lime {
        --tone-delay: 380ms;
      }
      .hero-mark circle {
        animation-duration: 720ms;
        animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
        animation-fill-mode: both;
      }
      .hero-mark .outer {
        animation-name: draw-outer;
        animation-delay: var(--tone-delay);
      }
      .hero-mark .inner {
        animation-name: draw-inner;
        animation-delay: calc(var(--tone-delay) + 120ms);
      }
      .hero-mark .endpoint {
        animation-name: endpoint-in;
        animation-delay: calc(var(--tone-delay) + 840ms);
        animation-duration: 120ms;
      }

      .wordmark {
        color: var(--wordmark);
        font-size: clamp(60px, 7vw, 116px);
        font-weight: 800;
        letter-spacing: 0;
        line-height: 0.86;
        transition: color 260ms ease;
        animation: wordmark-in 700ms cubic-bezier(0.2, 0.7, 0.2, 1) 440ms both;
      }

      .hero-download {
        height: 50px;
        margin-top: 4px;
        padding: 0 22px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 14px;
        background: var(--wordmark);
        color: var(--bg);
        font-size: 15px;
        font-weight: 750;
        text-decoration: none;
        pointer-events: auto;
        transition:
          color 260ms ease,
          background-color 260ms ease,
          transform 180ms ease;
        animation: wordmark-in 600ms cubic-bezier(0.2, 0.7, 0.2, 1) 620ms both;
      }
      html.js[data-view='home'] .hero-download {
        view-transition-name: hero-download;
      }
      .hero-download:hover {
        transform: translateY(-2px);
      }
      .hero-download:focus-visible {
        outline: 2px solid var(--lime);
        outline-offset: 4px;
      }
      .hero-download span[aria-hidden='true'] {
        font-size: 19px;
        line-height: 1;
      }

      .content-section {
        padding: clamp(72px, 5.5vw, 112px) 24px;
        background: var(--bg);
        color: var(--wordmark);
        transition:
          color 260ms ease,
          background-color 260ms ease;
      }
      .content-section.surface {
        background: var(--surface);
      }
      .section-inner {
        width: min(100%, 1120px);
        margin: 0 auto;
      }
      html.js .content-section {
        position: absolute;
        inset: 0;
        z-index: 4;
        padding-top: clamp(72px, 5.5vw, 112px);
        padding-bottom: clamp(56px, 4vw, 80px);
        overflow-y: auto;
        overscroll-behavior: contain;
        background: transparent;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(24px);
        transition:
          opacity 220ms ease,
          transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1),
          visibility 0s linear 420ms;
      }
      html.js .content-section.surface {
        background: transparent;
      }
      html.js .content-section .section-inner {
        min-height: calc(100vh - 176px - var(--footer-height));
        min-height: calc(100dvh - 176px - var(--footer-height));
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      html.js[data-view='download'] #download,
      html.js[data-view='security'] #security,
      html.js[data-view='support'] #support {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
        transition-delay: 160ms, 160ms, 0s;
        view-transition-name: scene-content;
      }
      html.js .site-footer {
        position: relative;
        z-index: 20;
      }
      html.has-view-transitions .ambient-mark,
      html.has-view-transitions .lockup,
      html.has-view-transitions .site-brand,
      html.has-view-transitions .content-section {
        transition: none;
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }
      ::view-transition-group(ambient-mark),
      ::view-transition-group(brand-mark),
      ::view-transition-group(brand-word) {
        animation-duration: 620ms;
        animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      ::view-transition-old(scene-content) {
        animation: scene-out 180ms ease both;
      }
      ::view-transition-new(scene-content) {
        animation: scene-in 420ms cubic-bezier(0.2, 0.7, 0.2, 1) 140ms both;
      }
      ::view-transition-old(hero-download) {
        animation: scene-out 180ms ease both;
      }
      .section-heading {
        max-width: 760px;
        margin-bottom: clamp(40px, 3.1vw, 64px);
      }
      .section-kicker {
        margin-bottom: 16px;
        color: var(--raspberry);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0;
        text-transform: uppercase;
      }
      .section-title {
        max-width: 720px;
        font-size: clamp(34px, 4vw, 52px);
        font-weight: 780;
        letter-spacing: 0;
        line-height: 1.08;
      }
      .section-copy {
        max-width: 680px;
        margin-top: 22px;
        color: var(--muted);
        font-size: clamp(16px, 1vw, 18px);
        line-height: 1.75;
      }

      .download-layout {
        padding: 36px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 48px;
      }
      .download-meta {
        display: grid;
        gap: 10px;
      }
      .download-meta strong {
        font-size: 21px;
        letter-spacing: 0;
      }
      .download-meta span {
        color: var(--muted);
        font-size: 15px;
        line-height: 1.6;
      }
      .download-action {
        display: grid;
        justify-items: end;
        gap: 10px;
      }
      .download-unavailable {
        height: 50px;
        padding: 0 20px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 15px;
        font-weight: 700;
        cursor: not-allowed;
      }
      .download-status {
        color: var(--muted);
        font-size: 12px;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }
      .info-item {
        min-height: 220px;
        padding: 32px 40px 32px 0;
        display: flex;
        flex-direction: column;
      }
      .info-item + .info-item {
        padding-left: 40px;
      }
      .info-item:not(:last-child) {
        border-right: 1px solid var(--line);
      }
      .info-mark {
        width: 30px;
        height: 4px;
        margin-bottom: 42px;
        background: var(--item-accent);
      }
      .info-item h3 {
        font-size: 19px;
        line-height: 1.3;
        letter-spacing: 0;
      }
      .info-item p {
        margin-top: 14px;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.7;
      }
      .info-item .info-status {
        margin-top: auto;
        padding-top: 24px;
        color: var(--muted);
        font-size: 12px;
      }
      .accent-purple {
        --item-accent: var(--purple);
      }
      .accent-raspberry {
        --item-accent: var(--raspberry);
      }
      .accent-lime {
        --item-accent: var(--lime);
      }

      .privacy-note {
        margin-top: 28px;
        padding: 22px 0 0 22px;
        border-top: 1px solid var(--line);
        border-left: 4px solid var(--raspberry);
        color: var(--muted);
        font-size: 14px;
        line-height: 1.7;
      }

      .support-footer {
        margin-top: 48px;
        padding-top: 28px;
        border-top: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
      }
      .support-footer p {
        max-width: 660px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.7;
      }
      .support-unavailable {
        color: var(--wordmark);
        font-size: 14px;
        font-weight: 750;
        white-space: nowrap;
      }

      .site-footer {
        height: var(--footer-height);
        padding: 0 28px;
        border-top: 0;
        background: transparent;
        color: var(--muted);
        transition: color 260ms ease;
      }
      .footer-inner {
        width: 100%;
        height: 100%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        font-size: 13px;
        transition: opacity 220ms ease;
      }
      html.js[data-view='home'] .footer-inner {
        opacity: 0.56;
      }
      html.js[data-view='home'] .site-footer:hover .footer-inner,
      html.js[data-view='home'] .site-footer:focus-within .footer-inner {
        opacity: 1;
      }
      .footer-domain {
        color: var(--wordmark);
        font-weight: 650;
        text-decoration: none;
      }
      .footer-domain:hover {
        color: var(--lime);
      }

      @keyframes scene-out {
        from {
          opacity: 1;
          transform: translateY(0);
        }
        to {
          opacity: 0;
          transform: translateY(-14px);
        }
      }
      @keyframes scene-in {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes ambient-in {
        from {
          opacity: 0;
          transform: translate(-50%, -50%) rotate(-14deg) scale(1.06);
        }
        to {
          opacity: var(--ambient-opacity);
          transform: translate(-50%, -50%) rotate(-8deg) scale(1);
        }
      }
      @keyframes draw-outer {
        from {
          opacity: 0;
          stroke-dasharray: 0 360;
        }
        to {
          opacity: 1;
          stroke-dasharray: 104 256;
        }
      }
      @keyframes endpoint-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @keyframes draw-inner {
        from {
          opacity: 0;
          stroke-dasharray: 0 360;
        }
        to {
          opacity: 1;
          stroke-dasharray: 78 282;
        }
      }
      @keyframes wordmark-in {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 900px) {
        .info-grid {
          grid-template-columns: 1fr;
        }
        .info-item {
          min-height: 0;
          padding: 28px 0;
        }
        .info-item:not(:last-child) {
          border-right: 0;
        }
        .info-item + .info-item {
          padding-left: 0;
          border-top: 1px solid var(--line);
        }
        .info-mark {
          margin-bottom: 28px;
        }
      }

      @media (max-width: 720px) {
        .toggle {
          width: 36px;
          height: 36px;
        }
        .site-header {
          width: 100%;
          height: 64px;
          padding: 0 16px;
        }
        .header-actions {
          gap: 14px;
        }
        .site-nav {
          gap: 18px;
        }
        .site-nav a:not(.nav-download) {
          display: none;
        }
        .ambient-mark {
          width: min(max(240vw, 120vh), 1200px);
          width: min(max(240vw, 120dvh), 1200px);
        }
        .lockup {
          gap: 18px;
          transform: translateY(-1vh);
        }
        .hero-mark {
          width: 220px;
        }
        .wordmark {
          font-size: 68px;
        }
        .hero-download {
          height: 46px;
          margin-top: 2px;
          padding: 0 18px;
        }
        .content-section {
          padding: 80px 20px;
        }
        html.js .content-section {
          padding: 92px 20px 72px;
        }
        html.js .content-section .section-inner {
          min-height: calc(100vh - 132px - var(--footer-height));
          min-height: calc(100dvh - 132px - var(--footer-height));
          justify-content: flex-start;
        }
        .section-heading {
          margin-bottom: 44px;
        }
        .section-title {
          font-size: 34px;
        }
        .section-copy {
          font-size: 16px;
        }
        .download-layout {
          grid-template-columns: 1fr;
          gap: 28px;
        }
        .download-action {
          justify-items: start;
        }
        .support-footer {
          display: grid;
        }
        .site-footer {
          padding: 0 16px;
        }
        .footer-inner {
          align-items: center;
          flex-direction: row;
          gap: 12px;
          font-size: 12px;
        }
      }

      @media (max-width: 380px) {
        .hero-mark {
          width: 196px;
        }
        .wordmark {
          font-size: 60px;
        }
      }

      @media (max-height: 700px) and (min-width: 721px) {
        .lockup {
          gap: 18px;
        }
        .hero-mark {
          width: 240px;
        }
        .wordmark {
          font-size: 84px;
        }
        .hero-download {
          height: 44px;
        }
